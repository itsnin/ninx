DATABASE_URL=file:/home/z/my-project/db/custom.db
# NextAuth — required for JWT session signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-in-production-please-use-a-long-random-string
# NextAuth URL — the canonical URL of the deployed site.
NEXTAUTH_URL=http://localhost:3000
# GitHub — set GITHUB_USERNAME to show your repos on the home page.
GITHUB_USERNAME=
# GitHub token (optional) — raises API rate limit from 60/hour to 5000/hour.
GITHUB_TOKEN=
# Google OAuth — set both to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple OAuth — set both to enable Apple sign-in.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
